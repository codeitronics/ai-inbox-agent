# ---- Mode ---------------------------------------------------------------------------------------
# true  = fictional demo mailbox, replies go to a mock Sent box (no Google account needed)
# false = your Gmail inbox (install with `uv sync --extra gmail`, add credentials.json)
DEMO_MODE=true
# Wipe and reseed the demo every N minutes (0 = never). Useful for a public demo.
DEMO_RESET_MINUTES=0

# ---- AI provider --------------------------------------------------------------------------------
# auto = first provider below with a key, otherwise recorded demo answers.
# Or set one of: recorded, anthropic, openai, gemini, deepseek
AI_PROVIDER=auto
# Leave empty for the default model of the provider (see inbox_agent/config.py).
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Gmail (DEMO_MODE=false) ---------------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
MAX_EMAILS_PER_RUN=25
POLL_INTERVAL_SECONDS=300
# Optional: also append every triaged email to this Google Sheet.
GOOGLE_SHEETS_ID=

# ---- Task export ---------------------------------------------------------------------------------
# Action items are POSTed here as JSON (see integrations/n8n for a ready-made n8n workflow).
TASK_WEBHOOK_URL=
TASK_WEBHOOK_SECRET=

# ---- Web UI -------------------------------------------------------------------------------------
# Required when DEMO_MODE=false (the UI shows your real inbox). Any username works.
WEB_PASSWORD=
# Path prefix when served behind a reverse proxy, e.g. /inbox
ROOT_PATH=
OWNER_NAME=Dana
OWNER_SIGNATURE="Dana Ruiz\nOperations Lead, Northwind Logistics"

# ---- Storage and stats ---------------------------------------------------------------------------
DATABASE_PATH=./data/inbox.db
MINUTES_SAVED_TRIAGE=1.5
MINUTES_SAVED_REPLY=6
